<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventra FiveM Console</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #080c14;
            color: #e2e8f0;
        }
        .panel-border {
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .panel-card {
            background-color: #0f172a;
        }
        .input-style {
            background-color: #060a12;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .input-style:focus {
            border-color: #3b82f6;
            outline: none;
        }
    </style>
</head>
<body class="min-h-screen p-6 flex flex-col justify-between">

    <header class="max-w-7xl mx-auto w-full panel-card panel-border rounded-xl p-5 mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <% if(bot && bot.avatarURL()) { %>
                <img src="<%= bot.avatarURL() %>" class="w-12 h-12 rounded-lg">
            <% } else { %>
                <div class="w-12 h-12 rounded-lg bg-gray-800 flex items-center justify-center font-bold">V</div>
            <% } %>
            <div>
                <h1 class="text-xl font-bold text-white tracking-tight"><%= bot ? bot.username : 'Ventra Infrastructure' %></h1>
                <p class="text-xs text-gray-400">FiveM Server Control & Automation</p>
            </div>
        </div>

        <div class="flex items-center gap-8 bg-black/40 px-6 py-3 rounded-lg panel-border">
            <div>
                <p class="text-[10px] uppercase font-semibold text-gray-500">Bağlı Sunucu</p>
                <p class="text-lg font-bold text-white"><%= guildsCount %></p>
            </div>
            <div class="w-[1px] h-6 bg-gray-800"></div>
            <div>
                <p class="text-[10px] uppercase font-semibold text-gray-500">Oyuncu Erişimi</p>
                <p class="text-lg font-bold text-white"><%= usersCount %></p>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-3 gap-8 mb-auto">
        <aside class="space-y-3">
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider px-1">Aktif Sunucular</h2>

            <% if(guilds.length > 0) { %>
                <% guilds.forEach(guild => { %>
                    <div class="panel-card panel-border p-4 rounded-xl flex items-center justify-between border-l-2 border-l-blue-500">
                        <div class="flex items-center gap-3">
                            <% if(guild.icon) { %>
                                <img src="<%= guild.icon %>" class="w-9 h-9 rounded-md">
                            <% } else { %>
                                <div class="w-9 h-9 rounded-md bg-gray-800 flex items-center justify-center text-xs font-bold"><%= guild.name.charAt(0) %></div>
                            <% } %>
                            <div>
                                <h3 class="font-medium text-sm text-white truncate max-w-[160px]"><%= guild.name %></h3>
                                <p class="text-[10px] text-gray-500">FiveM Senkronizasyonu Aktif</p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="panel-card panel-border p-5 rounded-xl text-center text-gray-500 text-xs">Bağlı sunucu bulunamadı.</div>
            <% } %>
        </aside>

        <section class="lg:col-span-2">
            <% if(guilds.length > 0) { %>
                <% let gid = guilds[0].id; %>
                
                <form action="/api/settings/<%= gid %>" method="POST" class="panel-card panel-border p-8 rounded-xl space-y-6">
                    <div class="border-b border-gray-800 pb-4">
                        <h2 class="text-lg font-bold text-white">FiveM Sunucu Yapılandırması</h2>
                        <p class="text-xs text-gray-400">Rol, kanal ve IP entegrasyon ayarları.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-medium text-gray-300">FiveM Server IP (connect IP:PORT)</label>
                            <input type="text" name="serverIp" value="<%= db.fetch(`server_ip_${gid}`) || '' %>" placeholder="185.125.xx.xx:30120" class="w-full p-3 rounded-lg input-style text-xs">
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-medium text-gray-300">Whitelist Rol ID</label>
                            <input type="text" name="wlRoleId" value="<%= db.fetch(`wl_role_${gid}`) || '' %>" placeholder="Rol ID Giriniz" class="w-full p-3 rounded-lg input-style text-xs">
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-medium text-gray-300">Kayıtsız Üye Rol ID</label>
                            <input type="text" name="unregRoleId" value="<%= db.fetch(`unregistered_role_${gid}`) || '' %>" placeholder="Rol ID Giriniz" class="w-full p-3 rounded-lg input-style text-xs">
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-medium text-gray-300">Karşılama Kanalı ID</label>
                            <input type="text" name="welcomeChannelId" value="<%= db.fetch(`welcomechannel_${gid}`) || '' %>" placeholder="Kanal ID Giriniz" class="w-full p-3 rounded-lg input-style text-xs">
                        </div>

                        <div class="space-y-2 md:col-span-2">
                            <label class="text-xs font-medium text-gray-300">Log Kanalı ID</label>
                            <input type="text" name="logChannelId" value="<%= db.fetch(`log_channel_${gid}`) || '' %>" placeholder="Denetim ve Log Kanal ID" class="w-full p-3 rounded-lg input-style text-xs">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <div class="p-4 rounded-lg bg-black/30 panel-border flex items-center justify-between">
                            <div>
                                <h4 class="text-xs font-semibold text-white">Küfür ve OOC Argo Filtresi</h4>
                                <p class="text-[10px] text-gray-500">Chat alanlarını otomatik tarar.</p>
                            </div>
                            <input type="checkbox" name="antiSwear" class="w-4 h-4 text-blue-600 rounded bg-gray-900 border-gray-700" <%= db.fetch(`antiswear_${gid}`) ? 'checked' : '' %>>
                        </div>

                        <div class="p-4 rounded-lg bg-black/30 panel-border flex items-center justify-between">
                            <div>
                                <h4 class="text-xs font-semibold text-white">Reklam / Bağlantı Engeli</h4>
                                <p class="text-[10px] text-gray-500">İzinsiz Discord/Site davetlerini engeller.</p>
                            </div>
                            <input type="checkbox" name="antiLink" class="w-4 h-4 text-blue-600 rounded bg-gray-900 border-gray-700" <%= db.fetch(`antilink_${gid}`) ? 'checked' : '' %>>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-semibold text-xs text-white transition-colors">
                        FiveM Veritabanını Güncelle
                    </button>
                </form>
            <% } %>
        </section>
    </main>

    <footer class="max-w-7xl mx-auto w-full text-center text-[10px] text-gray-600 mt-8">
        Ventra Infrastructure System
    </footer>

</body>
</html>
