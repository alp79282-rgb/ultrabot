<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= bot ? bot.username : 'Letra XII' %> - Yönetim Paneli</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col justify-between font-sans">
    
    <!-- Navbar -->
    <nav class="border-b border-zinc-800 bg-zinc-900/50 backdrop-blur p-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2 rounded-lg text-white font-bold"><i class="fa-solid fa-shield-halved"></i></div>
                <span class="text-xl font-bold tracking-wide">Letra XII <span class="text-indigo-500">Panel</span></span>
            </div>
            <div class="text-sm bg-zinc-800 px-3 py-1.5 rounded-full border border-zinc-700">
                Bot: <span class="text-emerald-400 font-semibold"><%= bot ? bot.tag : 'Bağlanıyor...' %></span>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto p-6 w-full flex-grow">
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold tracking-tight">Aktiflik Takip Paneli</h1>
            <p class="text-zinc-400 text-sm mt-1">Ekip üyelerinin oyun içi ve Discord aktiflik istatistikleri.</p>
        </div>

        <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-xl">
            <div class="p-4 border-b border-zinc-800 font-semibold text-zinc-300">
                <i class="fa-solid fa-users mr-2 text-indigo-500"></i> Kayıtlı Üye Aktivite Skorları
            </div>
            <div class="divide-y divide-zinc-800">
                <% if (records && records.length > 0) { %>
                    <% records.forEach(rec => { %>
                        <div class="p-4 flex justify-between items-center hover:bg-zinc-800/50 transition">
                            <span class="font-mono text-sm text-zinc-400">ID: <%= rec.userId %></span>
                            <span class="bg-indigo-500/10 text-indigo-400 px-3 py-1 rounded-full text-xs font-medium border border-indigo-500/20">
                                Skor / Süre: <%= rec.time %>
                            </span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-8 text-center text-zinc-500">
                        Henüz aktiflik verisi kaydedilmedi veya üyeler oyuna girmedi.
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 text-center py-4 text-xs text-zinc-500">
        Letra XII © 2026 - Tüm Hakları Saklıdır.
    </footer>
</body>
</html>
