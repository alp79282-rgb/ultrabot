<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventra Aktiflik Takip</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">
    <div class="max-w-6xl mx-auto px-4 py-10 w-full">
        <!-- Başlık Kısmı -->
        <div class="text-center mb-10">
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500">
                Ventra Aktiflik Takip
            </h1>
            <p class="text-slate-400 mt-2">Letra sunucusundaki Ventra oyuncularının güncel aktiflik ve puan sıralaması</p>
        </div>

        <!-- Liderlik Tablosu Kartı -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-800 bg-slate-900/50 text-slate-400 text-sm uppercase tracking-wider">
                            <th class="py-4 px-6">Sıra</th>
                            <th class="py-4 px-6">Oyuncu</th>
                            <th class="py-4 px-6 text-center">Günlük</th>
                            <th class="py-4 px-6 text-center">Haftalık</th>
                            <th class="py-4 px-6 text-center">Aylık</th>
                            <th class="py-4 px-6 text-right">Toplam Puan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        <% if (records && records.length > 0) { %>
                            <% records.forEach((user, index) => { %>
                                <tr class="hover:bg-slate-800/40 transition-colors">
                                    <td class="py-4 px-6 font-bold text-slate-300">
                                        <% if (index === 0) { %> 🥇 1 <% } else if (index === 1) { %> 🥈 2 <% } else if (index === 2) { %> 🥉 3 <% } else { %> #<%= index + 1 %> <% } %>
                                    </td>
                                    <td class="py-4 px-6 flex items-center space-x-3">
                                        <img src="<%= user.avatar %>" alt="Avatar" class="w-10 h-10 rounded-full border border-slate-700">
                                        <span class="font-semibold text-slate-200"><%= user.displayName %></span>
                                    </td>
                                    <td class="py-4 px-6 text-center text-slate-300"><%= user.dailyStr %></td>
                                    <td class="py-4 px-6 text-center text-slate-300"><%= user.weeklyStr %></td>
                                    <td class="py-4 px-6 text-center text-slate-300"><%= user.monthlyStr %></td>
                                    <td class="py-4 px-6 text-right font-black text-cyan-400"><%= user.totalStr %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-500">
                                    Henüz kaydedilmiş bir Letra aktifliği bulunmuyor.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Alt Bilgi -->
    <footer class="border-t border-slate-900 py-6 text-center text-slate-600 text-sm">
        Ventra x Letra Aktiflik Sistemi &copy; 2026
    </footer>
</body>
</html>
