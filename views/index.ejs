<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Letra XII | Yönetim Paneli</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-[#090a0f] text-gray-100 min-h-screen flex flex-col justify-between selection:bg-blue-500 selection:text-white">
    <header class="border-b border-white/5 backdrop-blur-md bg-black/20 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                <span class="font-bold tracking-wider text-lg">LETRA XII <span class="text-blue-500 font-light">CORE</span></span>
            </div>
            <% if (user) { %>
                <a href="/dashboard" class="bg-white/5 hover:bg-white/10 border border-white/10 px-4 py-2 rounded-xl text-sm font-medium transition duration-200">Panele Git</a>
            <% } %>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center px-6 py-20">
        <div class="max-w-xl text-center space-y-8">
            <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-widest">
                <span>Yetkili Kontrol Sistemi</span>
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                Gelişmiş Aktiflik ve <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">FiveM Takip Ekranı</span>
            </h1>
            <p class="text-gray-400 text-base sm:text-lg">
                Ekip üyelerinin oyun sürelerini, anlık durumlarını ve detaylı istatistiklerini web paneli üzerinden yönetin.
            </p>
            <div>
                <% if (user) { %>
                    <a href="/dashboard" class="inline-flex items-center justify-center px-8 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 font-semibold text-white shadow-lg shadow-blue-600/20 transition-all duration-200">
                        Yönetim Paneline Dön
                    </a>
                <% } else { %>
                    <a href="/callback" class="inline-flex items-center justify-center px-8 py-3.5 rounded-2xl bg-white hover:bg-gray-100 text-black font-semibold shadow-lg transition-all duration-200">
                        Discord ile Giriş Yap
                    </a>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="py-6 border-t border-white/5 text-center text-xs text-gray-500">
        &copy; 2026 Letra XII. Tüm hakları saklıdır.
    </footer>
</body>
</html>
