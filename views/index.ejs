<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Letra XII - Aktiflik Takip Sistemi</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #f3f4f6;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            position: relative;
        }

        /* Arka plan akışkan neon parlama efektleri */
        .bg-glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(11, 15, 25, 0) 70%);
            top: -100px;
            left: -100px;
            z-index: -1;
            animation: pulseGlow 8s infinite alternate ease-in-out;
        }

        .bg-glow-2 {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(147, 51, 234, 0.12) 0%, rgba(11, 15, 25, 0) 70%);
            bottom: -100px;
            right: -100px;
            z-index: -1;
            animation: pulseGlow 10s infinite alternate ease-in-out;
        }

        @keyframes pulseGlow {
            0% { transform: scale(1); opacity: 0.7; }
            100% { transform: scale(1.25); opacity: 1; }
        }

        .container {
            width: 100%;
            max-width: 1100px;
            z-index: 1;
        }

        header {
            text-align: center;
            margin-bottom: 45px;
            animation: fadeInDown 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        header h1 {
            font-size: 2.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            letter-spacing: -0.02em;
        }

        header p {
            color: #9ca3af;
            font-size: 1.05rem;
        }

        .stats-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
        }

        .stat-card {
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            padding: 22px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: rgba(129, 140, 248, 0.4);
            box-shadow: 0 15px 35px -10px rgba(99, 102, 241, 0.25);
        }

        .stat-card h3 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #9ca3af;
            margin-bottom: 8px;
        }

        .stat-card .number {
            font-size: 1.8rem;
            font-weight: 700;
            color: #f8fafc;
        }

        .leaderboard-box {
            background: rgba(17, 24, 39, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(16px);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
        }

        .table-header {
            padding: 24px 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 1.2rem;
            font-weight: 700;
            color: #f8fafc;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            transition: all 0.3s ease;
            opacity: 0;
            animation: fadeInRow 0.6s ease forwards;
        }

        .user-row:nth-child(1) { animation-delay: 0.1s; }
        .user-row:nth-child(2) { animation-delay: 0.2s; }
        .user-row:nth-child(3) { animation-delay: 0.3s; }
        .user-row:nth-child(4) { animation-delay: 0.4s; }
        .user-row:nth-child(5) { animation-delay: 0.5s; }

        @keyframes fadeInRow {
            to { opacity: 1; transform: translateY(0); }
            from { opacity: 0; transform: translateY(15px); }
        }

        .user-row:hover {
            background: rgba(30, 41, 59, 0.6);
            transform: scale(1.01);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 2px solid rgba(129, 140, 248, 0.4);
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .user-row:hover .user-avatar {
            transform: rotate(6deg) scale(1.08);
        }

        .user-details h4 {
            font-size: 1.05rem;
            font-weight: 600;
            color: #f1f5f9;
            margin-bottom: 3px;
        }

        .user-details .meta {
            font-size: 0.85rem;
            color: #94a3b8;
        }

        .user-times {
            display: grid;
            grid-template-columns: repeat(4, minmax(90px, 1fr));
            gap: 15px;
            text-align: right;
        }

        .time-box span {
            display: block;
            font-size: 0.72rem;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 2px;
            letter-spacing: 0.03em;
        }

        .time-box strong {
            font-size: 0.95rem;
            font-weight: 600;
            color: #e2e8f0;
        }

        .time-box.total strong {
            color: #818cf8;
        }

        .empty-state {
            padding: 60px;
            text-align: center;
            color: #94a3b8;
            font-size: 1.1rem;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Mobil Uyumlu Tasarım */
        @media(max-width: 850px) {
            .user-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
                padding: 20px;
            }
            .user-times {
                width: 100%;
                grid-template-columns: repeat(2, 1fr);
                text-align: left;
                background: rgba(15, 23, 42, 0.4);
                padding: 12px;
                border-radius: 12px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-glow"></div>
    <div class="bg-glow-2"></div>

    <div class="container">
        <header>
            <h1>Letra XII Aktiflik Takip</h1>
            <p>Sunucu üyelerinin anlık oyun süreleri ve sıralama paneli</p>
        </header>

        <div class="stats-bar">
            <div class="stat-card">
                <h3>Bot Durumu</h3>
                <div class="number" style="color: #4ade80;">● Aktif</div>
            </div>
            <div class="stat-card">
                <h3>Aktif Oyuncu</h3>
                <div class="number"><%= stats.activeCount %> Üye</div>
            </div>
            <div class="stat-card">
                <h3>Takip Edilen Sunucu</h3>
                <div class="number">1 Sunucu</div>
            </div>
        </div>

        <div class="leaderboard-box">
            <div class="table-header">
                🏆 Oyuncu Liderlik Sıralaması
            </div>

            <div class="user-list">
                <% if (records.length === 0) { %>
                    <div class="empty-state">Henüz oyunda aktif olan kimse bulunmuyor. Arkadaşların oyuna girdiğinde buraya yansıyacak!</div>
                <% } else { %>
                    <% records.forEach((user, index) => { %>
                        <div class="user-row">
                            <div class="user-profile">
                                <img src="<%= user.avatar %>" alt="Avatar" class="user-avatar">
                                <div class="user-details">
                                    <h4><%= user.displayName %></h4>
                                    <div class="meta">@<%= user.username %> &bull; (<%= user.userId %>)</div>
                                </div>
                            </div>

                            <div class="user-times">
                                <div class="time-box">
                                    <span>Bugün</span>
                                    <strong><%= user.dailyStr %></strong>
                                </div>
                                <div class="time-box">
                                    <span>Bu Hafta</span>
                                    <strong><%= user.weeklyStr %></strong>
                                </div>
                                <div class="time-box">
                                    <span>Bu Ay</span>
                                    <strong><%= user.monthlyStr %></strong>
                                </div>
                                <div class="time-box total">
                                    <span>Toplam</span>
                                    <strong><%= user.totalStr %></strong>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>
