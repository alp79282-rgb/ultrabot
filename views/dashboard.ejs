<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli | Letra XII</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-[#090a0f] text-gray-100 min-h-screen selection:bg-blue-500 selection:text-white">
    <!-- Navbar -->
    <header class="border-b border-white/5 backdrop-blur-md bg-black/20 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                <span class="font-bold tracking-wider text-lg">LETRA XII <span class="text-blue-500 font-light">PANEL</span></span>
            </div>
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2 bg-white/5 border border-white/10 px-3 py-1.5 rounded-xl">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" class="w-6 h-6 rounded-full" alt="Avatar">
                    <span class="text-sm font-medium"><%= user.username %></span>
                </div>
                <a href="/" class="text-xs text-gray-400 hover:text-white transition">Çıkış</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10 space-y-8">
        <!-- Başlık ve Filtreler -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Ekip Aktiflik ve Durum Takibi</h1>
                <p class="text-sm text-gray-400 mt-1">Sunucudaki tüm üyelerin FiveM oyun süreleri ve anlık durumları.</p>
            </div>
            <div class="flex items-center space-x-2 bg-white/5 p-1 rounded-xl border border-white/10">
                <a href="/dashboard?filter=daily" class="px-4 py-2 rounded-lg text-xs font-semibold transition <%= currentFilter === 'daily' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-400 hover:text-white' %>">Günlük</a>
                <a href="/dashboard?filter=weekly" class="px-4 py-2 rounded-lg text-xs font-semibold transition <%= currentFilter === 'weekly' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-400 hover:text-white' %>">Haftalık</a>
                <a href="/dashboard?filter=monthly" class="px-4 py-2 rounded-lg text-xs font-semibold transition <%= currentFilter === 'monthly' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-400 hover:text-white' %>">Aylık</a>
            </div>
        </div>

        <!-- Tablo Alanı -->
        <% guilds.forEach(guild => { %>
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-sm">
                <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
                    <h2 class="font-bold text-sm tracking-wide text-blue-400 uppercase">Sunucu: <%= guild.name %></h2>
                    <span class="text-xs text-gray-500"><%= guild.members.length %> Üye Listeleniyor</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 text-xs font-semibold text-gray-400 uppercase tracking-wider bg-black/20">
                                <th class="py-3 px-6">Üye</th>
                                <th class="py-3 px-6">Anlık Durum</th>
                                <th class="py-3 px-6">FiveM / RPC Bilgisi</th>
                                <th class="py-3 px-6 text-right">Toplam Süre</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-sm">
                            <% if (guild.members.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="py-8 text-center text-gray-500">Listelenecek üye bulunamadı.</td>
                                </tr>
                            <% } else { %>
                                <% guild.members.forEach((m, index) => { %>
                                    <tr class="hover:bg-white/[0.02] transition">
                                        <td class="py-4 px-6 flex items-center space-x-3">
                                            <span class="text-xs text-gray-500 font-bold w-6">#<%= index + 1 %></span>
                                            <img src="<%= m.avatar %>" class="w-9 h-9 rounded-full border border-white/10" alt="Avatar">
                                            <div>
                                                <div class="font-medium text-gray-200"><%= m.tag %></div>
                                                <div class="text-[11px] text-gray-500">ID: <%= m.id %></div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-6">
                                            <% if (m.isOnline) { %>
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                                    <span class="w-1.5 h-1.5 mr-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Oyunda / Aktif
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-500/10 text-gray-400 border border-white/5">
                                                    Çevrimdışı / Gizli
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="py-4 px-6 text-xs text-gray-300 font-mono">
                                            <%= m.rpcDetails %>
                                        </td>
                                        <td class="py-4 px-6 text-right font-bold text-blue-400">
                                            <%= Math.floor(m.totalMinutes / 60) %> Saat <%= m.totalMinutes % 60 %> Dk
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% }) %>
    </main>
</body>
</html>
